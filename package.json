{
  "name": "1person",
  "version": "0.1.0",
  "private": true,
  "description": "AI Company OS - Run your company with AI agents",
  "author": "1Person Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @1person/core db:generate",
    "db:migrate": "pnpm --filter @1person/core db:migrate",
    "db:studio": "pnpm --filter @1person/core db:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:migrate:all": "pnpm --filter @1person/core db:migrate && pnpm --filter @1person/ai-tenant db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
