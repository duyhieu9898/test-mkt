# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oneperson
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ==============================================
# AI Configuration (Feature-Specific)
# ==============================================
# Each feature can use different AI providers/models
# Provider options: "openai" or "anthropic"
# Models: gpt-4o-mini, gpt-4o (OpenAI) | claude-3-5-sonnet-20241022, claude-3-haiku-20240307 (Anthropic)

# FTUX (First Time User Experience) - Used during onboarding
FTUX_AI_PROVIDER=openai
FTUX_AI_MODEL=gpt-4o-mini

# Agent Runtime - Used for agent task execution and chat
AGENT_AI_PROVIDER=openai
AGENT_AI_MODEL=gpt-4o-mini

# API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Vector DB
QDRANT_URL=http://localhost:6333

# App
NODE_ENV=development
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8004/api/v1
WEB_URL=http://localhost:3004

# Object storage for generated/uploaded campaign images, blog images,
# banner exports, and landing page assets.
# Keeps development/staging/production files separated inside the bucket.
OBJECT_STORAGE_PREFIX=development

# AWS S3 asset storage
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=1person
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Public URL used by the browser, IMG.LY editor, and social publishers.
# Recommended: a CloudFront distribution URL or your custom CDN domain.
AWS_S3_PUBLIC_URL=

# Development with the free workers.dev URL:
LANDING_PAGE_PUBLIC_URL_MODE=path
LANDING_PAGE_PUBLIC_BASE_URL=https://your-worker.your-account.workers.dev

# Production with a domain you own:
# LANDING_PAGE_PUBLIC_URL_MODE=subdomain
# LANDING_PAGE_PUBLIC_BASE_DOMAIN=sites.your-domain.com

# Facebook / Meta
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OneDrive4
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Public web discovery
# Optional. Enables broader Google SERP discovery for Knowledge > Crawl Data
# and improves Content Grader real SERP analysis.
SERPAPI_KEY=

# IMG.LY CE.SDK server-side license for backend banner rendering/export.
# Leave empty to run evaluation mode with export watermark.
CESDK_LICENSE=

# IMG.LY CE.SDK browser license for the embedded banner editor.
# This value is exposed to the client bundle by design.
NEXT_PUBLIC_CESDK_LICENSE=

# Optional LLM observability. Keep disabled unless you run Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:5050
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
