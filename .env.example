# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oneperson
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@1person.ai
ADMIN_PASSWORD=Admin@1Person2025

# ==============================================
# AI Configuration (Feature-Specific)
# ==============================================
# Each feature can use different AI providers/models
# Provider options: "openai" or "anthropic"
# Models: gpt-4o-mini, gpt-4o (OpenAI) | claude-3-5-sonnet-20241022, claude-3-haiku-20240307 (Anthropic)

# FTUX (First Time User Experience) - Used during onboarding
FTUX_AI_PROVIDER=openai
FTUX_AI_MODEL=gpt-4o-mini

# Agent Runtime - Used for agent task execution and chat
AGENT_AI_PROVIDER=openai
AGENT_AI_MODEL=gpt-4o-mini

# API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI video generation via OpenRouter video API.
# Generated videos are downloaded by the API and persisted into AWS S3 below.
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=x-ai/grok-imagine-video-1.5
OPENROUTER_VIDEO_DURATION_SECONDS=4
# Valid OpenRouter values: 480p, 720p, 1080p, 1K, 2K, 4K. Code maps legacy 540p to 480p for local testing.
OPENROUTER_VIDEO_RESOLUTION=480p
OPENROUTER_VIDEO_GENERATE_AUDIO=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=1Person
VIDEO_RENDER_SYNC_INTERVAL_MS=30000
VIDEO_RENDER_SYNC_BATCH_SIZE=5

# Vector DB
QDRANT_URL=http://localhost:6333

# App
NODE_ENV=development
API_PORT=8004
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8004/api/v1
WEB_URL=http://localhost:3004

# Object storage for generated/uploaded campaign images, blog images,
# banner exports, and landing page assets.
# Keeps development/staging/production files separated inside the bucket.
OBJECT_STORAGE_PREFIX=development

# AWS S3 asset storage
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=1person
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Public URL used by the browser, IMG.LY editor, and social publishers.
# Recommended: a CloudFront distribution URL or your custom CDN domain.
AWS_S3_PUBLIC_URL=

# Hosted landing pages. Nginx should proxy /sites/* to the API.
LANDING_PAGE_PUBLIC_URL_MODE=path
LANDING_PAGE_PUBLIC_BASE_URL=https://1person.bap-software.net/sites

# Optional advanced mode for future wildcard/custom-domain hosting:
# LANDING_PAGE_PUBLIC_URL_MODE=subdomain
# LANDING_PAGE_PUBLIC_BASE_DOMAIN=sites.your-domain.com

# OAuth application credentials shared by the 1Person deployment.
# Customers connect their own provider accounts; their tokens are stored per user/company.
# Setup and rotation guide: docs/guides/oauth-provider-console-setup.md

# Facebook / Meta Page publishing
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Drive (Web OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OneDrive (use common for multi-tenant + personal accounts)
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# IMG.LY CE.SDK server-side license for backend banner rendering/export.
# Leave empty to run evaluation mode with export watermark.
CESDK_LICENSE=

# IMG.LY CE.SDK browser license for the embedded banner editor.
# This value is exposed to the client bundle by design.
NEXT_PUBLIC_CESDK_LICENSE=

# Optional LLM observability. Keep disabled unless you run Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:5050
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
