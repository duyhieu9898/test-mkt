# ============================================
# 1Person AI Company OS - Production Environment
# Domain: https://1person.bap-software.net
# ============================================
# IMPORTANT: Copy this file to .env on the production server
# and fill in all values. DO NOT commit .env to git.

# --- Server ---
NODE_ENV=production
API_PORT=8004
WEB_PORT=3004

# --- URLs ---
WEB_URL=https://1person.bap-software.net
NEXT_PUBLIC_API_URL=https://1person.bap-software.net/api/v1

# --- Database ---
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=oneperson
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/oneperson

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# --- Authentication ---
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# --- Admin Account (auto-created on first start) ---
ADMIN_EMAIL=admin@1person.ai
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- AI API Keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- AI Configuration ---
FTUX_AI_PROVIDER=openai
FTUX_AI_MODEL=gpt-4o-mini
AGENT_AI_PROVIDER=openai
AGENT_AI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
