# =============================================================================
# 1Person On-Premise Deployment — Environment Template
# =============================================================================
# Copy this file to .env in the same directory, fill in values, then run:
#   docker compose -f on-premise.yml --env-file .env up -d
# =============================================================================

# --- Database -----------------------------------------------------------------
POSTGRES_USER=postgres
# MUST CHANGE — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-postgres-password

# --- Admin account ------------------------------------------------------------
ADMIN_EMAIL=admin@yourcompany.com
# MUST CHANGE — generate with: openssl rand -base64 16
ADMIN_PASSWORD=change-me-strong-admin-password

# --- JWT + Encryption ---------------------------------------------------------
# MUST CHANGE — generate with: openssl rand -base64 64
JWT_SECRET=change-me-generate-a-64-byte-secret

# MASTER KEY for BYO-API-key encryption (P0-A2).
# MUST CHANGE — this encrypts every per-tenant API key at rest.
# If you lose this, all stored tenant keys become unrecoverable.
# Generate with: openssl rand -base64 64
TRUSTAI_KEY_ENCRYPTION_KEY=change-me-unique-per-deployment

# --- Langfuse (LLM observability) ---------------------------------------------
# MUST CHANGE — generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth
LANGFUSE_SALT=change-me-langfuse-salt

# Public URL where Langfuse will be reachable (behind your reverse proxy)
LANGFUSE_PUBLIC_URL=https://yourcompany.com/langfuse

# API keys used by the main app to talk to self-hosted Langfuse.
# These are generated by Langfuse on first boot — the defaults below work
# for fresh installs. Log into Langfuse and rotate for production.
LANGFUSE_PUBLIC_KEY=pk-lf-onprem-1person
LANGFUSE_SECRET_KEY=sk-lf-onprem-1person

# --- vLLM model selection -----------------------------------------------------
# Default: Qwen 2 7B Instruct (~14GB VRAM, fits on a single A10/L4/4090)
# Alternatives:
#   - meta-llama/Llama-3.1-8B-Instruct    (needs HF access approval)
#   - mistralai/Mistral-7B-Instruct-v0.3  (~14GB VRAM)
#   - Qwen/Qwen2.5-14B-Instruct           (~28GB VRAM, A100 recommended)
VLLM_MODEL=Qwen/Qwen2-7B-Instruct

# Hugging Face token — required only for gated models (Llama, etc.)
HUGGING_FACE_HUB_TOKEN=

# --- Public URLs --------------------------------------------------------------
# The URL where the web app is reachable to end users
PUBLIC_WEB_URL=https://yourcompany.com
# The URL where the API is reachable to the web frontend
PUBLIC_API_URL=https://yourcompany.com/api/v1

# --- Optional: Error tracking -------------------------------------------------
# Only set if you run a self-hosted GlitchTip / Sentry. Leave blank for
# full air-gap deployments.
SENTRY_DSN=
